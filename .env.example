# Environment Configuration for Finance Transaction System
# Copy this file to .env and update with your actual values
# NEVER commit .env file to version control

# Email Notifications Configuration
# Set to 'true' to disable all email notifications (fallback to pre-email state)
# Set to 'false' or remove to enable email notifications
DISABLE_EMAIL_NOTIFICATIONS=false

# SMTP Email Configuration (only used if DISABLE_EMAIL_NOTIFICATIONS=false)
# Gmail SMTP settings (recommended for development)
# IMPORTANT: For Gmail, you MUST use an App Password, not your regular password
# 1. Enable 2-factor authentication on your Google account
# 2. Go to Google Account → Security → App passwords
# 3. Generate a new app password for "Mail"
# 4. Use that 16-character password below (remove spaces)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_AUTH=true
SMTP_USERNAME=thomus.lg@gmail.com
SMTP_PASSWORD=wrlmoiewpitdhwdf
SMTP_FROM_EMAIL=thomus.lg@gmail.com
SMTP_FROM_NAME=Finance Transaction System

# Alternative SMTP providers:
# For Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls

# For Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls

# For custom SMTP server:
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=tls

# SMTP Debug Level (0=off, 1=client, 2=client+server, 3=client+server+connection, 4=low-level)
SMTP_DEBUG=0

# SMTP Timeout in seconds
SMTP_TIMEOUT=30

# Database Configuration
# Default XAMPP MySQL settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance
DB_USER=root
DB_PASS=

# Alternative database configurations:
# For custom MySQL installation:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=your_username
# DB_PASS=your_password

# For remote database:
# DB_HOST=your-server.com
# DB_PORT=3306
# DB_USER=remote_user
# DB_PASS=remote_password

# Application Configuration
# APP_ENV=development
# APP_DEBUG=true
# APP_URL=http://localhost/finance

# Security Configuration
# SESSION_LIFETIME=7200
# CSRF_TOKEN_LIFETIME=3600
